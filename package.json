{
  "name": "google-forms-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google Forms integration",
  "type": "module",
  "main": "build/index.js",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "start": "node build/index.js",
    "build:token": "tsc -p tsconfig.json",
    "get-refresh-token": "pnpm run build:token && node build/get-refresh-token.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "open": "^9.1.0",
    "server-destroy": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/server-destroy": "^1.0.4",
    "typescript": "^5.8.3",
    "undici-types": "^7.8.0"
  },
  "pnpm": {
    "overrides": {
      "gaxios": "^7.3.0",
      "@hono/node-server": "^2.0.11",
      "google-auth-library": "^10.9.1"
    }
  }
}
